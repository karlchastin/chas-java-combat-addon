{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.attacking": {
      "initial_state": "default",
      "states": {
        "default": { "transitions": [{ "attacking": "variable.attack_time" }] },
        "attacking": {
          "on_entry": [ "/scriptevent javacombat:swinging" ],
          "transitions": [{ "default": "!variable.attack_time" }]
        }
      }
    }
  }
}